{
  "name": "enterpriseverse",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload",
    "test:simulation": "pnpm --dir packages/simulation test",
    "typecheck:simulation": "pnpm exec tsc --noEmit -p packages/simulation/tsconfig.json",
    "typecheck:web": "pnpm --dir apps/web exec tsc --noEmit",
    "build:web": "pnpm --dir apps/web build",
    "check:api": "python -m compileall -q apps/api/app",
    "qa:experience": "node apps/web/scripts/experience-qa.mjs",
    "qa:architecture": "node apps/web/scripts/architecture-qa.mjs",
    "qa:polish": "node apps/web/scripts/polish-qa.mjs",
    "qa:release": "node apps/web/scripts/release-qa.mjs",
    "qa:ui-foundation": "node apps/web/scripts/ui-foundation-qa.mjs",
    "qa:core-simulator": "node apps/web/scripts/core-simulator-qa.mjs",
    "qa:entry-experience": "node apps/web/scripts/entry-experience-qa.mjs",
    "check": "pnpm test:simulation && pnpm typecheck:simulation && pnpm typecheck:web && pnpm check:api && pnpm qa:experience && pnpm qa:architecture && pnpm qa:polish && pnpm qa:release && pnpm qa:ui-foundation && pnpm qa:core-simulator && pnpm qa:entry-experience && pnpm build:web"
  }
}
